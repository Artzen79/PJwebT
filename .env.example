# Copy to .env (git-ignored) and adjust. Every value has a development default, so .env is optional locally.

# PostgreSQL connection (docker compose up -d starts one with these credentials)
DATABASE_URL=postgres://sporthub:sporthub@localhost:5432/sporthub

# Signs login tokens. REQUIRED in production: use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Outgoing mail. Mailpit (docker compose) catches everything at http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=SportHub <no-reply@sporthub.local>

# Public URL of the web app, used for links inside emails
APP_URL=http://localhost:5173

# PromptPay phone number or national ID that receives payments
PROMPTPAY_ID=0812345678

# How many minutes before the first slot a booking may check in (30 in real use; larger for demos)
CHECKIN_EARLY_MINUTES=30

# PORT=3000
# NODE_ENV=production
